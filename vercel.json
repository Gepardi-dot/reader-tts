{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "python vercel_install.py",
  "buildCommand": "python vercel_build.py",
  "outputDirectory": "web-next/dist",
  "functions": {
    "api/app.py": {
      "includeFiles": "server/**,pdf_to_audio.py"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
