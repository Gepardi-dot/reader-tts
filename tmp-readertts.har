            "mimeType": "application/json",
            "text": "{\"defaultNarrationStyle\":\"Read like a premium audiobook narrator. Keep the pacing controlled, the phrasing natural, and the delivery emotionally aware without adding or changing any words from the text.\",\"providers\":[{\"id\":\"qwen\",\"name\":\"Qwen TTS\",\"available\":true,\"recommended\":true,\"description\":\"Instruction-guided narration through DashScope with expressive voices and lower-cost synthesis.\",\"voices\":[{\"id\":\"Cherry\",\"label\":\"Cherry\",\"gender\":\"female\",\"genderSource\":\"provider\",\"style\":\"Lively\",\"tags\":[\"Story\"],\"models\":[\"qwen3-tts-instruct-flash\",\"qwen3-tts-flash\"]},{\"id\":\"Serena\",\"label\":\"Serena\",\"gender\":\"female\",\"genderSource\":\"provider\",\"style\":\"Warm\",\"tags\":[\"Story\"],\"models\":[\"qwen3-tts-instruct-flash\",\"qwen3-tts-flash\"]},{\"id\":\"Jennifer\",\"label\":\"Jennifer\",\"gender\":\"female\",\"genderSource\":\"provider\",\"style\":\"Clear\",\"models\":[\"qwen3-tts-flash\"]},{\"id\":\"Mia\",\"label\":\"Mia\",\"gender\":\"female\",\"genderSource\":\"provider\",\"style\":\"Bright\",\"models\":[\"qwen3-tts-instruct-flash\",\"qwen3-tts-flash\"]},{\"id\":\"Bellona\",\"label\":\"Bellona\",\"gender\":\"female\",\"genderSource\":\"provider\",\"style\":\"Dramatic\",\"tags\":[\"Story\"],\"models\":[\"qwen3-tts-instruct-flash\",\"qwen3-tts-flash\"]},{\"id\":\"Ethan\",\"label\":\"Ethan\",\"gender\":\"male\",\"genderSource\":\"provider\",\"style\":\"Natural\",\"models\":[\"qwen3-tts-instruct-flash\",\"qwen3-tts-flash\"]},{\"id\":\"Ryan\",\"label\":\"Ryan\",\"gender\":\"male\",\"genderSource\":\"provider\",\"style\":\"Conversational\",\"models\":[\"qwen3-tts-flash\"]},{\"id\":\"Aiden\",\"label\":\"Aiden\",\"gender\":\"male\",\"genderSource\":\"provider\",\"style\":\"Measured\",\"models\":[\"qwen3-tts-flash\"]},{\"id\":\"Neil\",\"label\":\"Neil\",\"gender\":\"male\",\"genderSource\":\"provider\",\"style\":\"Steady\",\"models\":[\"qwen3-tts-instruct-flash\",\"qwen3-tts-flash\"]},{\"id\":\"Vincent\",\"label\":\"Vincent\",\"gender\":\"male\",\"genderSource\":\"provider\",\"style\":\"Deep\",\"tags\":[\"Story\"],\"models\":[\"qwen3-tts-instruct-flash\",\"qwen3-tts-flash\"]},{\"id\":\"Arthur\",\"label\":\"Arthur\",\"gender\":\"male\",\"genderSource\":\"provider\",\"style\":\"Classic\",\"tags\":[\"Story\"],\"models\":[\"qwen3-tts-instruct-flash\",\"qwen3-tts-flash\"]},{\"id\":\"Elias\",\"label\":\"Elias\",\"gender\":\"male\",\"genderSource\":\"provider\",\"style\":\"Smooth\",\"models\":[\"qwen3-tts-instruct-flash\",\"qwen3-tts-flash\"]}],\"defaultVoice\":\"Cherry\",\"models\":[{\"id\":\"qwen3-tts-instruct-flash\",\"label\":\"Qwen3 TTS Instruct Flash\",\"description\":\"Expressive instruction-guided narration for audiobooks, dramatic reads, and premium previews.\",\"storytelling\":true},{\"id\":\"qwen3-tts-flash\",\"label\":\"Qwen3 TTS Flash\",\"description\":\"Lower-cost multilingual speech synthesis for straightforward narration and utility reads.\",\"storytelling\":false}],\"defaultModel\":\"qwen3-tts-instruct-flash\",\"voiceMetaNote\":\"Gender labels for Qwen voices come from Alibaba's voice catalog. Qwen TTS currently does not expose timestamps.\"},{\"id\":\"google\",\"name\":\"Google Gemini TTS\",\"available\":true,\"recommended\":true,\"description\":\"Preview Gemini audiobook-style TTS with a free tier and promptable delivery.\",\"voices\":[{\"id\":\"Zephyr\",\"label\":\"Zephyr\",\"gender\":\"neutral\",\"genderSource\":\"estimated\",\"style\":\"Bright\"},{\"id\":\"Puck\",\"label\":\"Puck\",\"gender\":\"male\",\"genderSource\":\"estimated\",\"style\":\"Upbeat\"},{\"id\":\"Charon\",\"label\":\"Charon\",\"gender\":\"male\",\"genderSource\":\"estimated\",\"style\":\"Informative\"},{\"id\":\"Kore\",\"label\":\"Kore\",\"gender\":\"female\",\"genderSource\":\"estimated\",\"style\":\"Firm\",\"tags\":[\"Story\"]},{\"id\":\"Fenrir\",\"label\":\"Fenrir\",\"gender\":\"male\",\"genderSource\":\"estimated\",\"style\":\"Excitable\"},{\"id\":\"Leda\",\"l