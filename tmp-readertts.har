            "text": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <meta name=\"theme-color\" content=\"#23414b\" />\n    <meta name=\"storybook-build\" content=\"2026-03-30T23:40:44.378Z\" />\n    <link rel=\"manifest\" href=\"/manifest.webmanifest\" />\n    <title>Storybook Reader</title>\n    <script>\n      ;(() => {\n        try {\n          const buildId =\n            document.querySelector('meta[name=\"storybook-build\"]')?.getAttribute('content') || 'storybook-dev-build'\n          const cleanupFlag = `storybook-origin-cleanup:${buildId}`\n          const buildKey = 'storybook-origin-build'\n          const previousBuildId = window.localStorage?.getItem(buildKey)\n          const shouldRefreshForNewBuild = previousBuildId !== buildId\n\n          if (!shouldRefreshForNewBuild && window.sessionStorage?.getItem(cleanupFlag)) {\n            return\n          }\n\n          const tasks = []\n          let shouldReload = shouldRefreshForNewBuild\n\n          if ('serviceWorker' in navigator) {\n            tasks.push(\n              navigator.serviceWorker.getRegistrations().then((registrations) => {\n                if (registrations.length) {\n                  shouldReload = true\n                }\n                return Promise.all(registrations.map((registration) => registration.unregister()))\n              }),\n            )\n          }\n\n          if ('caches' in window) {\n            tasks.push(\n              caches.keys().then((keys) => {\n                if (keys.length) {\n                  shouldReload = true\n                }\n                return Promise.all(keys.map((key) => caches.delete(key)))\n              }),\n            )\n          }\n\n          if (!tasks.length) {\n            return\n          }\n\n          Promise.allSettled(tasks).then(() => {\n            if (!shouldReload) {\n              try {\n                window.localStorage?.setItem(buildKey, buildId)\n              } catch {\n                // Ignore localStorage issues and continue booting.\n              }\n              return\n            }\n\n            try {\n              window.sessionStorage?.setItem(cleanupFlag, '1')\n              window.localStorage?.setItem(buildKey, buildId)\n            } catch {\n              // Ignore sessionStorage issues and continue with the refresh.\n            }\n\n            window.location.reload()\n          })\n        } catch {\n          // Ignore cleanup failures and allow the app bundle to boot normally.\n        }\n      })()\n    </script>\n    <script type=\"module\" crossorigin src=\"/assets/index-D9d3Tec4.js\"></script>\n    <link rel=\"stylesheet\" crossorigin href=\"/assets/index-DbagcC_Y.css\">\n  </head>\n  <body>\n    <div id=\"root\"></div>\n  </body>\n</html>\n"
