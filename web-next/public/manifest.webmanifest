{
  "id": "/",
  "name": "HiggsRead",
  "short_name": "HiggsRead",
  "description": "Read books, listen with high-quality voices, and keep the words that matter.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F7F7F5",
  "theme_color": "#F7F7F5",
  "categories": ["books", "education", "productivity"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest.webmanifest"
    }
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-narrow.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "HiggsRead — read, listen, remember"
    },
    {
      "src": "/screenshot-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "HiggsRead — your library, always at hand"
    }
  ],
  "shortcuts": [
    {
      "name": "Library",
      "short_name": "Library",
      "description": "Open your books",
      "url": "/library",
      "icons": [{ "src": "/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Add a book",
      "short_name": "Add",
      "description": "Upload a PDF, EPUB, or document",
      "url": "/upload",
      "icons": [{ "src": "/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Practice",
      "short_name": "Practice",
      "description": "Review vocabulary",
      "url": "/studio",
      "icons": [{ "src": "/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/upload",
      "launch_type": "single-client",
      "accept": {
        "application/pdf": [".pdf"],
        "application/epub+zip": [".epub"],
        "application/epub": [".epub"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "application/vnd.oasis.opendocument.text": [".odt"],
        "application/rtf": [".rtf"],
        "text/rtf": [".rtf"],
        "text/plain": [".txt", ".text", ".md", ".markdown", ".log", ".rst", ".org"],
        "text/markdown": [".md", ".markdown"],
        "text/html": [".html", ".htm"],
        "application/xhtml+xml": [".xhtml"],
        "text/csv": [".csv"],
        "application/json": [".json"],
        "application/x-fictionbook+xml": [".fb2"]
      }
    }
  ]
}
