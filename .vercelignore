# Patterns use a leading `/` for repo-root only. Without it, gitignore-style
# matching applies in EVERY directory (e.g. `scripts/` also dropped
# `web-next/scripts/assert-vercel-api-origin.mjs` and broke Vercel builds).

# Node modules
/web/node_modules/
/web-rewrite/node_modules/
/web-next/node_modules/

# Build outputs (built on Vercel, not uploaded)
/web/dist/
/web-rewrite/dist/
/web-next/dist/
/public/

# Local data / virtual envs
/library/
/output/
.venv/
.venv-qwen3-tts/

# Large local-only assets
/voices/neutts/*
/dictionary/offline/*
/dictionary/extracted/*
/dictionary/open-wordnet/*

# Dev / test artifacts
/web/test-results/
/web-rewrite/test-results/
/web-next/test-results/
/test-results/
*.log
*.err.log
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.playwright-cli/
.agents/
.stitch/designs/*
.claude/worktrees/

# Secrets — but keep production Vite API origin for the SPA build
.env
.env.local
.env.*.local
!.env.example
!web-next/.env.production

# Legacy Python FastAPI — API is Cloudflare Worker now (do not ship as Vercel function)
/app.py
/server/
/requirements.txt
/vercel_install.py
/vercel_build.py
/pdf_to_audio.py
# Root-only helpers (oracle, deploy wrappers). Do NOT use bare `scripts/` —
# that also ignores web-next/scripts/ needed by build:vercel.
/scripts/
/supabase/
/cloudflare/
Dockerfile*
fly.*.toml
railway.*.toml
/convert-book.ps1
/start-*.cmd
/start-*.ps1
/web-rewrite/
/web/
/dictionary/
/docs/
/tmp-*.txt
/tmp-*.json
/tmp-*.js
/tmp-*.spec.js
/tmp-*.png
/tmp-*.har
*.png
# Brand assets required by the SPA build (logo import + public favicons)
!web-next/src/assets/higgsread-*.png
!web-next/public/favicon.png
!web-next/public/favicon-16.png
!web-next/public/favicon-32.png
!web-next/public/favicon-48.png
!web-next/public/favicon-64.png
!web-next/public/apple-touch-icon.png
*.har

# Explicit keep (belt-and-suspenders if a broader pattern is added later)
!/web-next/scripts/
!/web-next/scripts/**
