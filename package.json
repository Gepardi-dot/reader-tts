{
  "name": "storybook-reader",
  "private": true,
  "scripts": {
    "build": "npm --prefix web-next run build",
    "lint": "npm --prefix web-next run lint",
    "dev": "npm --prefix web-next run dev",
    "test": "npm --prefix web-next run test -- --pool=threads",
    "preview": "npm --prefix web-next run preview",
    "worker:dev": "npx wrangler dev --config cloudflare/worker/wrangler.toml --local",
    "worker:deploy": "npx wrangler deploy --config cloudflare/worker/wrangler.toml",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "d1:migrate:local": "npx wrangler d1 migrations apply reader_tts --local --config cloudflare/worker/wrangler.toml",
    "d1:migrate:remote": "npx wrangler d1 migrations apply reader_tts --remote --config cloudflare/worker/wrangler.toml",
    "pages:deploy": "npm run build && npx wrangler pages deploy web-next/dist --project-name reader-tts",
    "rewrite:build": "npm --prefix web-rewrite run build",
    "rewrite:dev": "npm --prefix web-rewrite run dev",
    "rewrite:lint": "npm --prefix web-rewrite run lint",
    "rewrite:test": "npm --prefix web-rewrite run test",
    "rewrite:e2e": "npm --prefix web-rewrite run test:e2e"
  }
}
